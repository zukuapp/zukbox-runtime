{
  "name": "@zukbox/runtime",
  "version": "0.1.1",
  "description": "ZUKBOX .zwf runtime — WebAssembly player core and its host loader.",
  "license": "MIT",
  "type": "module",
  "main": "./js/zwf-loader.mjs",
  "repository": "github:zukuapp/zukbox-runtime",
  "publishConfig": { "access": "public" },
  "exports": {
    ".": "./js/zwf-loader.mjs",
    "./writer": "./js/zwf-writer.mjs",
    "./player": "./js/zwf-player.mjs",
    "./render-queue": "./js/zwf-render-queue.mjs",
    "./wasm": "./dist/zwf_runtime.wasm"
  },
  "files": [
    "js/zwf-loader.mjs",
    "js/zwf-writer.mjs",
    "js/zwf-player.mjs",
    "js/zwf-render-queue.mjs",
    "dist/zwf_runtime.wasm"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "prepack": "npm run build:wasm",
    "test:packed": "node scripts/test-packed.mjs",
    "test:rust": "cargo test",
    "test:js": "node --test \"js/**/*.test.mjs\"",
    "test": "npm run test:rust && npm run build:wasm && npm run test:js"
  },
  "engines": {
    "node": ">=22"
  }
}
